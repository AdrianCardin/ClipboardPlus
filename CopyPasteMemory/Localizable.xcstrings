    "No se ha podido guardar este elemento de forma permanente (fallo del Llavero o del almacenamiento del sistema). Inténtalo de nuevo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Element konnte nicht dauerhaft gespeichert werden (Fehler im Schlüsselbund oder Speicher). Bitte versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This item couldn't be saved permanently (Keychain or storage failure). Please try again."
